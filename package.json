		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"fake-indexeddb": "6.2.7",
		"jsdom": "30.1.3",
