		"@prisma/client": "7.10.1",
		"@tanstack/react-query": "5.105.0",
		"blurhash": "2.0.5",
		"idb-keyval": "6.3.0",
		"lucide-react": "1.67.0",
		"next": "16.4.5",
		"onnxruntime-web": "1.31.1",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"prisma": "7.10.1",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"sharp": "0.35.5",
