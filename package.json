{
	"name": "wardrobe",
	"version": "1.1.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "aube@2.9.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "node --env-file-if-exists=.env prisma/seed.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1167.0",
		"@aws-sdk/s3-request-presigner": "3.1167.0",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@tanstack/react-query": "5.107.1",
		"blurhash": "2.0.5",
		"idb-keyval": "6.3.0",
		"lucide-react": "1.72.0",
		"next": "16.4.6",
		"pg": "8.23.1",
		"pg-boss": "12.38.2",
		"prisma": "7.10.1",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"sharp": "0.35.5",
		"uqr": "0.1.3",
		"zod": "4.6.7",
		"zxing-wasm": "3.1.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@tailwindcss/postcss": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.10",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"fake-indexeddb": "6.2.8",
		"jsdom": "31.0.0",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
