{
	"name": "wardrobe",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "node prisma/seed.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1161.0",
		"@aws-sdk/s3-request-presigner": "3.1161.0",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"lucide-react": "1.67.0",
		"next": "16.4.4",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"prisma": "7.10.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@tailwindcss/postcss": "4.3.4",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "4.3.4",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
