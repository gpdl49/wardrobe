// Data model: docs/wardrobe.md "Data model" in gpdl49/homestacks is the
// contract. Change it there first.
//
// The connection URL lives in ../prisma.config.ts (CLI) and lib/db (runtime).
datasource db {
  provider = "postgresql"
}

// Generated into the source tree (gitignored) by `prisma generate`, which
// postinstall runs. Queries go through the @prisma/adapter-pg driver adapter,
// so there is no query engine binary to ship.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// IDs are UUIDv7 generated by Prisma (time-ordered). `updatedAt` also has a
// database default so raw SQL inserts (prisma/seed.mjs) need not set it.

enum LocationKind {
  bag
  vacuum_bag
  suitcase
  closet
  drawer
  other

  @@map("location_kind")
}

enum Season {
  spring
  summer
  autumn
  winter

  @@map("season")
}

enum ItemStatus {
  active
  stored
  lent
  donated
  discarded

  @@map("item_status")
}

enum PhotoKind {
  main
  label
  detail
  /// A photo of an outfit being worn (Photo.outfitId), not of one item.
  outfit

  @@map("photo_kind")
}

enum PhotoStatus {
  pending
  processing
  ready
  failed

  @@map("photo_status")
}

enum PhotoBackgroundStatus {
  queued
  ready
  skipped
  failed

  @@map("photo_background_status")
}

enum SessionMode {
  pack
  unpack

  @@map("session_mode")
}

enum AnalysisKind {
  colors
  vision

  @@map("analysis_kind")
}

enum AnalysisStatus {
  queued
  running
  done
  failed

  @@map("analysis_status")
}

enum SuggestionStatus {
  queued
  running
  done
  failed

  @@map("suggestion_status")
}

enum SuggestionFeedback {
  saved
  dismissed

  @@map("suggestion_feedback")
}

enum ShareAccess {
  view
  edit

  @@map("share_access")
}

/// A signed-in person, created or updated from the oauth2-proxy headers on
/// sign-in (lib/auth). Everything except categories belongs to one owner.
model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Zitadel subject (X-Forwarded-User).
  sub       String   @unique @db.VarChar(255)
  email     String?  @db.VarChar(320)
  username  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  locations      Location[]
  tags           Tag[]
  items          Item[]
  photos         Photo[]
  sessions       PackingSession[]
  sharesOwned    Share[]          @relation("ShareOwner")
  sharesReceived Share[]          @relation("ShareGrantee")

  outfits              Outfit[]
  outfitSharesReceived OutfitShare[]
  immichConnection     ImmichConnection?
  immichAssetsLinked   OutfitImmichAsset[]
  suggestionRunsOwned  SuggestionRun[]     @relation("SuggestionRunOwner")
  suggestionRunsAsked  SuggestionRun[]     @relation("SuggestionRunRequester")

  @@index([email])
  @@index([username])
  @@map("users")
}

/// Grants another user access to an owner's whole wardrobe (null locationId)
/// or to one location and everything nested in it. A second, partial unique
/// index in the migration covers the null case, which @@unique cannot.
model Share {
  id         String      @id @default(uuid(7)) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  owner      User        @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  granteeId  String      @map("grantee_id") @db.Uuid
  grantee    User        @relation("ShareGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  access     ShareAccess
  locationId String?     @map("location_id") @db.Uuid
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([ownerId, granteeId, locationId])
  @@index([granteeId])
  @@index([locationId])
  @@map("shares")
}

/// A place an item can be: a numbered vacuum bag, a suitcase, a closet...
/// Locations nest (a bag stored in the loft closet).
model Location {
  id         String       @id @default(uuid(7)) @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind       LocationKind
  /// Upper-case label code (B-07, S-02, CL-BEDROOM), unique per owner. QR
  /// labels encode https://wardrobe.vidur.xyz/l/<ownerId>/<code>.
  code       String       @db.VarChar(32)
  name       String       @db.VarChar(200)
  notes      String?
  parentId   String?      @map("parent_id") @db.Uuid
  parent     Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Location[]   @relation("LocationTree")
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict: a location that still holds items cannot be deleted (API 409).
  items         Item[]
  sessions      PackingSession[]
  movementsFrom Movement[]       @relation("MovementFrom")
  movementsTo   Movement[]       @relation("MovementTo")
  shares        Share[]

  @@unique([ownerId, code])
  @@index([parentId])
  @@index([kind])
  @@map("locations")
}

/// Category tree (Tops -> Knitwear -> Cardigan). Seeded by prisma/seed.mjs.
model Category {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  parentId  String?    @map("parent_id") @db.Uuid
  // Restrict: delete or move the children first.
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items Item[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id      String      @id @default(uuid(7)) @db.Uuid
  ownerId String      @map("owner_id") @db.Uuid
  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Lower-case, unique per owner.
  name    String      @db.VarChar(64)
  items   ItemTag[]
  outfits OutfitTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

model Item {
  id           String     @id @default(uuid(7)) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Optional: rapid packing capture creates nameless items.
  name         String?    @db.VarChar(200)
  nameGenerated Boolean @default(false)
  categoryId   String?    @map("category_id") @db.Uuid
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        String?    @db.VarChar(100)
  size         String?    @db.VarChar(50)
  /// [{name, hex, share}], see lib/items (feature code) for the zod schema.
  colors       Json       @default("[]")
  pattern      String?    @db.VarChar(50)
  material     String?    @db.VarChar(100)
  seasons      Season[]   @default([])
  status       ItemStatus @default(active)
  locationId   String?    @map("location_id") @db.Uuid
  location     Location?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notes        String?
  coverPhotoId String?    @unique @map("cover_photo_id") @db.Uuid
  coverPhoto   Photo?     @relation("ItemCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  photos    Photo[]      @relation("ItemPhotos")
  tags      ItemTag[]
  movements Movement[]
  analyses  Analysis[]
  outfits   OutfitItem[]

  @@index([ownerId, createdAt, id])
  @@index([locationId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt, id])
  @@map("items")
}

model ItemTag {
  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

/// Object keys: photos/<id>/original, photos/<id>/display.webp,
/// photos/<id>/thumb.webp and optional cutout variants (lib/s3). Deleting rows does not delete objects;
/// the API deletes the objects.
///
/// An unassigned photo belongs to its uploader; assigning it to an item passes
/// it to that item's owner. An outfit photo (kind `outfit`, `outfitId` set)
/// belongs to the outfit's owner; a check constraint in the migration keeps a
/// photo from having both an item and an outfit.
model Photo {
  id               String                 @id @default(uuid(7)) @db.Uuid
  ownerId          String                 @map("owner_id") @db.Uuid
  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Null while a packing capture is unassigned.
  itemId           String?                @map("item_id") @db.Uuid
  item             Item?                  @relation("ItemPhotos", fields: [itemId], references: [id], onDelete: Cascade)
  outfitId         String?                @map("outfit_id") @db.Uuid
  outfit           Outfit?                @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  kind             PhotoKind
  status           PhotoStatus            @default(pending)
  backgroundStatus PhotoBackgroundStatus? @map("background_status")
  contentType      String                 @map("content_type") @db.VarChar(100)
  /// Bytes of the original.
  size             Int
  width            Int?
  height           Int?
  blurhash         String?                @db.VarChar(100)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coverOf  Item?      @relation("ItemCoverPhoto")
  analyses Analysis[]

  @@index([ownerId])
  @@index([itemId])
  @@index([outfitId])
  @@index([status])
  @@map("photos")
}

model PackingSession {
  id         String      @id @default(uuid(7)) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mode       SessionMode
  locationId String      @map("location_id") @db.Uuid
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startedAt  DateTime    @default(now()) @map("started_at") @db.Timestamptz
  endedAt    DateTime?   @map("ended_at") @db.Timestamptz

  movements Movement[]

  @@index([ownerId])
  @@index([locationId])
  @@map("packing_sessions")
}

/// Every change of Item.locationId writes one.
model Movement {
  id             String          @id @default(uuid(7)) @db.Uuid
  itemId         String          @map("item_id") @db.Uuid
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocationId String?         @map("from_location_id") @db.Uuid
  fromLocation   Location?       @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?         @map("to_location_id") @db.Uuid
  toLocation     Location?       @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  sessionId      String?         @map("session_id") @db.Uuid
  session        PackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  at             DateTime        @default(now()) @db.Timestamptz

  @@index([itemId, at])
  @@index([sessionId])
  @@map("movements")
}

model Analysis {
  id        String         @id @default(uuid(7)) @db.Uuid
  itemId    String         @map("item_id") @db.Uuid
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  photoId   String?        @map("photo_id") @db.Uuid
  photo     Photo?         @relation(fields: [photoId], references: [id], onDelete: SetNull)
  kind      AnalysisKind
  /// Vision model id (OpenRouter) or the local algorithm name.
  model     String?        @db.VarChar(200)
  status    AnalysisStatus @default(queued)
  result    Json?
  error     String?
  appliedAt DateTime?      @map("applied_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([itemId])
  @@index([photoId])
  @@map("analyses")
}

/// A saved set of items from one owner's wardrobe (docs/outfits/contract.md).
/// Readable by the owner, whole-wardrobe grantees and OutfitShare grantees.
model Outfit {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String   @db.VarChar(200)
  notes     String?
  seasons   Season[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items        OutfitItem[]
  tags         OutfitTag[]
  /// Uploaded photos (kind `outfit`). The API deletes their objects.
  photos       Photo[]
  immichAssets OutfitImmichAsset[]
  shares       OutfitShare[]
  suggestion   OutfitSuggestion?

  @@index([ownerId, createdAt, id])
  @@map("outfits")
}

model OutfitItem {
  outfitId String @map("outfit_id") @db.Uuid
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  itemId   String @map("item_id") @db.Uuid
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Order within the outfit, ascending.
  position Int    @default(0)

  @@id([outfitId, itemId])
  @@index([itemId])
  @@map("outfit_items")
}

model OutfitTag {
  outfitId String @map("outfit_id") @db.Uuid
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  tagId    String @map("tag_id") @db.Uuid
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([outfitId, tagId])
  @@index([tagId])
  @@map("outfit_tags")
}

/// View access to one outfit for one user.
model OutfitShare {
  id        String   @id @default(uuid(7)) @db.Uuid
  outfitId  String   @map("outfit_id") @db.Uuid
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  granteeId String   @map("grantee_id") @db.Uuid
  grantee   User     @relation(fields: [granteeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([outfitId, granteeId])
  @@index([granteeId])
  @@map("outfit_shares")
}

/// An Immich asset linked to an outfit by reference. Bytes are streamed from
/// Immich on demand with the linker's API key (ImmichConnection).
model OutfitImmichAsset {
  id         String    @id @default(uuid(7)) @db.Uuid
  outfitId   String    @map("outfit_id") @db.Uuid
  outfit     Outfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  linkedById String    @map("linked_by_id") @db.Uuid
  linkedBy   User      @relation(fields: [linkedById], references: [id], onDelete: Cascade)
  /// Immich asset id.
  assetId    String    @map("asset_id") @db.Uuid
  fileName   String?   @map("file_name") @db.VarChar(255)
  width      Int?
  height     Int?
  /// Immich's thumbhash (base64), for a placeholder.
  thumbhash  String?   @db.VarChar(100)
  takenAt    DateTime? @map("taken_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([outfitId, assetId])
  @@index([linkedById])
  @@map("outfit_immich_assets")
}

/// A user's Immich API key, encrypted with SECRETS_KEY (lib/immich).
model ImmichConnection {
  userId       String   @id @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `v1:<iv>:<tag>:<ciphertext>`, each part base64url (AES-256-GCM).
  apiKey       String   @map("api_key")
  immichUserId String   @map("immich_user_id") @db.VarChar(64)
  immichEmail  String?  @map("immich_email") @db.VarChar(320)
  immichName   String?  @map("immich_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("immich_connections")
}

/// One request for outfit suggestions and the model call that answers it.
model SuggestionRun {
  id            String           @id @default(uuid(7)) @db.Uuid
  /// The wardrobe the outfits are suggested from.
  ownerId       String           @map("owner_id") @db.Uuid
  owner         User             @relation("SuggestionRunOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requestedById String           @map("requested_by_id") @db.Uuid
  requestedBy   User             @relation("SuggestionRunRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  status        SuggestionStatus @default(queued)
  /// SuggestionRequest (lib/api/types.ts).
  request       Json
  /// OpenRouter model id.
  model         String?          @db.VarChar(200)
  error         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  suggestions OutfitSuggestion[]

  @@index([ownerId, createdAt])
  @@map("suggestion_runs")
}

/// One proposed outfit. `feedback` records what the user did with it.
model OutfitSuggestion {
  id        String              @id @default(uuid(7)) @db.Uuid
  runId     String              @map("run_id") @db.Uuid
  run       SuggestionRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Same as the run's owner; kept here for lookups by owner.
  ownerId   String              @map("owner_id") @db.Uuid
  position  Int                 @default(0)
  name      String              @db.VarChar(200)
  rationale String?
  /// Item ids; not a foreign key, so items deleted since are skipped on read.
  itemIds   String[]            @map("item_ids") @db.Uuid
  feedback  SuggestionFeedback?
  /// The outfit this was saved as.
  outfitId  String?             @unique @map("outfit_id") @db.Uuid
  outfit    Outfit?             @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([runId])
  @@index([ownerId, feedback])
  @@map("outfit_suggestions")
}

/// Idempotency-Key bookkeeping for POSTs (lib/http/idempotency). A row is
/// inserted (pending: `status` null) before the handler runs, so the unique
/// (sub, key) serialises concurrent duplicates; the response is stored once
/// the handler returns (2xx/4xx; a 5xx deletes the row so it can be retried).
/// Rows older than 7 days are deleted on write.
model IdempotencyKey {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// oauth2-proxy `X-Forwarded-User`: keys are scoped per user.
  sub          String    @db.VarChar(255)
  key          String    @db.VarChar(200)
  /// "POST /api/items".
  route        String    @db.VarChar(200)
  /// SHA-256 (hex) of the raw request body.
  requestHash  String    @map("request_hash") @db.Char(64)
  /// Null while the first request is in flight.
  status       Int?
  responseBody Json?     @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// When the in-flight request took the key; a stale lock can be taken over.
  lockedAt     DateTime  @default(now()) @map("locked_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  @@unique([sub, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
