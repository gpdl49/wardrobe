// Data model: docs/wardrobe.md "Data model" in gpdl49/homestacks is the
// contract. Change it there first.
//
// The connection URL lives in ../prisma.config.ts (CLI) and lib/db (runtime).
datasource db {
  provider = "postgresql"
}

// Generated into the source tree (gitignored) by `prisma generate`, which
// postinstall runs. Queries go through the @prisma/adapter-pg driver adapter,
// so there is no query engine binary to ship.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// IDs are UUIDv7 generated by Prisma (time-ordered). `updatedAt` also has a
// database default so raw SQL inserts (prisma/seed.mjs) need not set it.

enum LocationKind {
  bag
  suitcase
  closet
  drawer
  other

  @@map("location_kind")
}

enum Season {
  spring
  summer
  autumn
  winter

  @@map("season")
}

enum ItemStatus {
  active
  stored
  lent
  donated
  discarded

  @@map("item_status")
}

enum PhotoKind {
  main
  label
  detail

  @@map("photo_kind")
}

enum PhotoStatus {
  pending
  processing
  ready
  failed

  @@map("photo_status")
}

enum SessionMode {
  pack
  unpack

  @@map("session_mode")
}

enum AnalysisKind {
  colors
  vision

  @@map("analysis_kind")
}

enum AnalysisStatus {
  queued
  running
  done
  failed

  @@map("analysis_status")
}

/// A place an item can be: a numbered vacuum bag, a suitcase, a closet...
/// Locations nest (a bag stored in the loft closet).
model Location {
  id         String       @id @default(uuid(7)) @db.Uuid
  kind       LocationKind
  /// Unique, upper-case label code (B-07, S-02, CL-BEDROOM). QR labels encode
  /// https://wardrobe.vidur.xyz/l/<code>.
  code       String       @unique @db.VarChar(32)
  name       String       @db.VarChar(200)
  notes      String?
  parentId   String?      @map("parent_id") @db.Uuid
  parent     Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Location[]   @relation("LocationTree")
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict: a location that still holds items cannot be deleted (API 409).
  items         Item[]
  sessions      PackingSession[]
  movementsFrom Movement[]       @relation("MovementFrom")
  movementsTo   Movement[]       @relation("MovementTo")

  @@index([parentId])
  @@index([kind])
  @@map("locations")
}

/// Category tree (Tops -> Knitwear -> Cardigan). Seeded by prisma/seed.mjs.
model Category {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  parentId  String?    @map("parent_id") @db.Uuid
  // Restrict: delete or move the children first.
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items Item[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id    String    @id @default(uuid(7)) @db.Uuid
  /// Unique, lower-case.
  name  String    @unique @db.VarChar(64)
  items ItemTag[]

  @@map("tags")
}

model Item {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Optional: rapid packing capture creates nameless items.
  name         String?    @db.VarChar(200)
  categoryId   String?    @map("category_id") @db.Uuid
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        String?    @db.VarChar(100)
  size         String?    @db.VarChar(50)
  /// [{name, hex, share}], see lib/items (feature code) for the zod schema.
  colors       Json       @default("[]")
  pattern      String?    @db.VarChar(50)
  material     String?    @db.VarChar(100)
  seasons      Season[]   @default([])
  status       ItemStatus @default(active)
  locationId   String?    @map("location_id") @db.Uuid
  location     Location?  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notes        String?
  coverPhotoId String?    @unique @map("cover_photo_id") @db.Uuid
  coverPhoto   Photo?     @relation("ItemCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  photos    Photo[]    @relation("ItemPhotos")
  tags      ItemTag[]
  movements Movement[]
  analyses  Analysis[]

  @@index([locationId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt, id])
  @@map("items")
}

model ItemTag {
  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

/// Object keys: photos/<id>/original, photos/<id>/display.webp,
/// photos/<id>/thumb.webp (lib/s3). Deleting rows does not delete objects;
/// the API deletes the objects.
model Photo {
  id          String      @id @default(uuid(7)) @db.Uuid
  /// Null while a packing capture is unassigned.
  itemId      String?     @map("item_id") @db.Uuid
  item        Item?       @relation("ItemPhotos", fields: [itemId], references: [id], onDelete: Cascade)
  kind        PhotoKind
  status      PhotoStatus @default(pending)
  contentType String      @map("content_type") @db.VarChar(100)
  /// Bytes of the original.
  size        Int
  width       Int?
  height      Int?
  blurhash    String?     @db.VarChar(100)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coverOf  Item?      @relation("ItemCoverPhoto")
  analyses Analysis[]

  @@index([itemId])
  @@index([status])
  @@map("photos")
}

model PackingSession {
  id         String      @id @default(uuid(7)) @db.Uuid
  mode       SessionMode
  locationId String      @map("location_id") @db.Uuid
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  startedAt  DateTime    @default(now()) @map("started_at") @db.Timestamptz
  endedAt    DateTime?   @map("ended_at") @db.Timestamptz

  movements Movement[]

  @@index([locationId])
  @@map("packing_sessions")
}

/// Every change of Item.locationId writes one.
model Movement {
  id             String          @id @default(uuid(7)) @db.Uuid
  itemId         String          @map("item_id") @db.Uuid
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocationId String?         @map("from_location_id") @db.Uuid
  fromLocation   Location?       @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?         @map("to_location_id") @db.Uuid
  toLocation     Location?       @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  sessionId      String?         @map("session_id") @db.Uuid
  session        PackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  at             DateTime        @default(now()) @db.Timestamptz

  @@index([itemId, at])
  @@index([sessionId])
  @@map("movements")
}

model Analysis {
  id        String         @id @default(uuid(7)) @db.Uuid
  itemId    String         @map("item_id") @db.Uuid
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  photoId   String?        @map("photo_id") @db.Uuid
  photo     Photo?         @relation(fields: [photoId], references: [id], onDelete: SetNull)
  kind      AnalysisKind
  /// Vision model id (OpenRouter) or the local algorithm name.
  model     String?        @db.VarChar(200)
  status    AnalysisStatus @default(queued)
  result    Json?
  error     String?
  appliedAt DateTime?      @map("applied_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([itemId])
  @@index([photoId])
  @@map("analyses")
}
