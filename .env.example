# Copy to .env for local development (see README.md).
DATABASE_URL=postgresql://wardrobe:wardrobe@localhost:5432/wardrobe
# Separate database for `aube test`; it is wiped between tests.
TEST_DATABASE_URL=postgresql://wardrobe:wardrobe@localhost:5432/wardrobe_test

# "dev" signs every request in as a fixed local user. Refused in production.
AUTH_MODE=dev
REQUIRED_GROUP=wardrobe
# Members may edit categories. The AUTH_MODE=dev user is always in it.
ADMIN_GROUP=wardrobe-admin

# MinIO from compose.yaml
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=wardrobe
AWS_SECRET_ACCESS_KEY=wardrobe-secret
PHOTO_BUCKET=centerpoint-wardrobe-photos
S3_ENDPOINT=http://localhost:9000

# Optional: image analysis is disabled without it.
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=
# OPENROUTER_TEXT_MODEL=

# Optional: linking Immich photos to outfits needs both.
# IMMICH_URL=https://immich.example.com
# Base64 of 32 random bytes (openssl rand -base64 32): encrypts stored Immich API keys.
# SECRETS_KEY=

# Optional: Apple App Site Association (AASA) for iOS universal links.
# Comma-separated list of <team>.<bundle>. Production value: 2J2LYH5QBS.xyz.vidur.wardrobe
# IOS_APP_IDS=
